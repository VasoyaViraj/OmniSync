generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = "5"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                   String                @id @default(uuid())
  name                 String
  email                String                @unique
  department           String
  designation          String
  location             String
  manager_id           String?
  tenure_years         Float                 @default(0)
  performance_score    Float                 @default(0)
  engagement_score     Float                 @default(0)
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt
  alerts               EmployeeAlert[]
  notes                EmployeeNote[]
  manager              Employee?             @relation("ManagerRelation", fields: [manager_id], references: [id])
  reports              Employee[]            @relation("ManagerRelation")
  institutional_memory InstitutionalMemory[]
  meetings             Meeting[]

  @@index([manager_id])
  @@map("employees")
}

model Meeting {
  id                 String           @id @default(uuid())
  employee_id        String
  hr_id              String
  meeting_date       DateTime
  audio_url          String?
  transcript         String?
  summary            String?
  sentiment          String?
  next_followup_date DateTime?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  insights           MeetingInsight[]
  employee           Employee         @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@map("meetings")
}

model MeetingInsight {
  id              String   @id @default(uuid())
  meeting_id      String
  key_takeaways   String?
  action_items    String?
  risk_flags      String?
  sentiment_score Float    @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
  meeting         Meeting  @relation(fields: [meeting_id], references: [id], onDelete: Cascade)

  @@index([meeting_id])
  @@map("meeting_insights")
}

model EmployeeAlert {
  id          String   @id @default(uuid())
  employee_id String
  alert_type  String
  description String
  severity    String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@map("employee_alerts")
}

model EmployeeNote {
  id          String   @id @default(uuid())
  employee_id String
  note        String
  created_by  String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@map("employee_notes")
}

model InstitutionalMemory {
  id          String   @id @default(uuid())
  employee_id String
  event_type  String
  title       String
  description String?
  source      String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@index([employee_id])
  @@map("institutional_memory")
}

model meeting_intelligence {
  id                   String   @id
  title                String
  date                 DateTime
  participants         Json
  transcript           String
  summary              Json?
  actionItems          Json?
  speakerContributions Json?
  employeeInsights     Json?
  created_at           DateTime @default(now())
  updated_at           DateTime
}
